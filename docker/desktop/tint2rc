# Bots' dock (Orbit): a blue-gray glass bar floating at the bottom centre, launchers only. Fill #94aece at 32%, a white
# outline at 36%, 16px corners, 48px icons. tint2 draws it over a copy of the wallpaper, so it needs no compositor.

# Background 1: the bar, and its tooltips.
rounded = 16
border_width = 1
border_sides = TBLR
background_color = #94aece 32
border_color = #ffffff 36

# The bar: as wide as its launchers, 8px above the screen's bottom edge, kept above windows, which maximize above it.
panel_items = L
panel_size = 100% 72
panel_shrink = 1
panel_margin = 0 8
panel_padding = 10 0 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_dock = 0
wm_menu = 0
strut_policy = follow_size
panel_window_name = dock
disable_transparency = 0
mouse_effects = 1
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 -10
font_shadow = 0

# Launchers: Files, Google Chrome, Mousepad.
launcher_padding = 0 0 4
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 48
launcher_icon_theme_override = 0
launcher_tooltip = 1
startup_notifications = 1
launcher_item_app = /usr/share/applications/thunar.desktop
launcher_item_app = /usr/local/share/applications/google-chrome.desktop
launcher_item_app = /usr/share/applications/org.xfce.mousepad.desktop

tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 8 6
tooltip_background_id = 1
tooltip_font_color = #ffffff 100
