# Shared release config, read by the release pipeline (scripts/) and the installer. In CI, a repository variable of the
# same name overrides a value here without a commit.

# Where the installer is served from: `curl -fsSL $OPENBOT_SITE_URL/install.sh | bash`.
OPENBOT_SITE_URL=https://openbot.lemedi.dev

# The runtime image's repository; each image is tagged r<N>, the revision of its definition (see scripts/src/facts.ts).
OPENBOT_RUNTIME_IMAGE=ghcr.io/lemedi/openbot-runtime
