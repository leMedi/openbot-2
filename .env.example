# Folder for all local state: libSQL db, pi auth/models, pi-durable storage.
# Relative paths resolve against the repo root.
OPENBOT_DATA_DIR=./data

# The bots' home: shared/ and bots/<id>/, where bots' shell and file tools work. Default /home/openbot (the runtime
# image's). Bots run only in the runtime image: started anywhere else, the server refuses to run them.
# OPENBOT_HOME=/home/openbot

# Encrypts stored provider credentials (at least 32 characters, e.g. `openssl rand -base64 32`).
# When unset, one is generated into $OPENBOT_DATA_DIR/secret.key on first boot. Losing it loses the credentials.
# OPENBOT_SECRET_KEY=

# Where the web app listens. The runtime image sets OPENBOT_HOST=0.0.0.0; on the host the default is localhost.
# OPENBOT_HOST=
# OPENBOT_PORT=3000

# The address you open OpenBot at, e.g. a host name; requests for its host are allowed.
# OPENBOT_PUBLIC_URL=

# The screen daemon's socket (apps/desktopd), where the server finds bots' screens. Without a daemon, e.g. on the host,
# bots work but have no screen.
# OPENBOT_DESKTOPD_SOCKET=/run/openbot/desktopd.sock
