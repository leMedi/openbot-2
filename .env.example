# Folder for all local state: libSQL db, pi auth/models, pi-durable storage.
# Relative paths resolve against the repo root.
OPENBOT_DATA_DIR=./data

# Encrypts stored provider credentials (at least 32 characters, e.g. `openssl rand -base64 32`).
# When unset, one is generated into $OPENBOT_DATA_DIR/secret.key on first boot. Losing it loses the credentials.
# OPENBOT_SECRET_KEY=
