{
  "name": "@openbot/webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "dev": "pnpm with-env vite dev --port 3000",
    "build": "pnpm with-env vite build",
    "start": "pnpm with-env vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openbot/agent": "workspace:*",
    "@openbot/api-contract": "workspace:*",
    "@openbot/core": "workspace:*",
    "@openbot/db": "workspace:*",
    "@openbot/ui": "workspace:*",
    "@orpc/openapi": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "1.16.1",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
